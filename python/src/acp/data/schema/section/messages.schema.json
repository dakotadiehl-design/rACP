{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora.invalid/acp/schema/section/messages.schema.json",
  "title": "ACP section payloads",
  "$defs": {
    "enter": {
      "type": "object",
      "additionalProperties": true,
      "required": ["section_id"],
      "properties": {
        "show_id": { "$ref": "../common/defs.schema.json#/$defs/uuid" },
        "song_id": { "type": "string" },
        "section_id": { "type": "string" },
        "idempotency_key": { "$ref": "../common/defs.schema.json#/$defs/uuid" }
      }
    },
    "exit": {
      "type": "object",
      "additionalProperties": true,
      "required": ["section_id"],
      "properties": {
        "show_id": { "$ref": "../common/defs.schema.json#/$defs/uuid" },
        "song_id": { "type": "string" },
        "section_id": { "type": "string" }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": true,
      "required": ["section_id"],
      "properties": {
        "show_id": { "$ref": "../common/defs.schema.json#/$defs/uuid" },
        "song_id": { "type": "string" },
        "section_id": { "type": "string" },
        "bar": { "$ref": "../common/defs.schema.json#/$defs/uint64" },
        "beat": { "$ref": "../common/defs.schema.json#/$defs/uint64" }
      }
    }
  }
}
