{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora.invalid/acp/schema/config/schema.schema.json",
  "title": "config.schema payload",
  "type": "object",
  "additionalProperties": true,
  "required": ["fields"],
  "properties": {
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["path", "value_type"],
        "properties": {
          "path": { "type": "string" },
          "value_type": { "type": "string" },
          "secret": { "type": "boolean" },
          "writable": { "type": "boolean" },
          "restart_required": { "type": "boolean" },
          "description": { "type": "string" }
        }
      }
    }
  }
}
