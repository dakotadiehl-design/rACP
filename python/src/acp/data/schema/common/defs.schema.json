{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora.invalid/acp/schema/common/defs.schema.json",
  "title": "ACP common definitions",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "RFC 4122 UUID, lowercase hyphenated hex. No preferred version."
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "MAJOR.MINOR protocol or capability version"
    },
    "role": {
      "type": "string",
      "enum": ["conductor", "prism", "lyric", "bridge", "tool", "simulator", "remote"]
    },
    "remote_role": {
      "type": "string",
      "enum": ["remote.viewer", "remote.operator", "remote.busker", "remote.show_navigation", "remote.admin"]
    },
    "remote_permission": {
      "type": "string",
      "minLength": 1,
      "description": "Permission identifier. Unknown permissions never grant access and are preserved for forward-compatible policy display.",
      "x-known-values": [
        "observe",
        "song.select",
        "song.load",
        "cue.execute",
        "look.execute",
        "busk.execute",
        "output.grand_master",
        "output.blackout",
        "output.blackout.engage",
        "output.blackout.clear",
        "remote.surface.use"
      ]
    },
    "remote_profile_id": {
      "type": "string",
      "enum": ["aurora.remote.prism.v1", "aurora.remote.conductor.v1", "remote"]
    },
    "remote_delivery": {
      "type": "string",
      "enum": ["stateful", "impulse", "live_ephemeral"]
    },
    "remote_transition_mode": {
      "type": "string",
      "enum": ["cut", "fade"]
    },
    "remote_show_mode": {
      "type": "string",
      "enum": ["programmed", "free_play"]
    },
    "remote_interaction": {
      "type": "string",
      "enum": ["activate", "set", "adjust", "momentary_begin", "momentary_end", "momentary_cancel"]
    },
    "remote_control_type": {
      "type": "string",
      "minLength": 1,
      "description": "Known types are enumerated in constants; unknown types are skipped by compatible clients."
    },
    "remote_control_type_known": {
      "type": "string",
      "enum": [
        "button",
        "momentary",
        "momentary_button",
        "toggle",
        "slider",
        "fader",
        "encoder",
        "rotary",
        "selector",
        "segmented_selector",
        "xy",
        "xy_pad",
        "transport",
        "navigation",
        "status",
        "meter",
        "color",
        "color_control",
        "preset_tile",
        "label",
        "value_display",
        "status_indicator",
        "group",
        "spacer"
      ]
    },
    "remote_failsafe": {
      "type": "string",
      "enum": ["release_on_disconnect", "release_on_timeout", "hold_last_state", "authority_defined"]
    },
    "remote_concurrency": {
      "type": "string",
      "enum": ["shared", "exclusive", "single_owner", "authority_defined"]
    },
    "remote_readiness": {
      "type": "string",
      "enum": ["connecting", "negotiating", "syncing_assets", "syncing_state", "ready", "ready_with_warnings", "degraded", "blocked", "disconnected"]
    },
    "remote_feedback": {
      "type": "string",
      "enum": ["none", "ack_only", "state", "meter", "progress"]
    },
    "remote_safety_class": {
      "type": "string",
      "enum": ["normal", "caution", "dangerous"]
    },
    "remote_platform": {
      "type": "string",
      "enum": ["ios", "ipados", "macos", "android", "web", "hardware", "simulator"]
    },
    "remote_asset_type": {
      "type": "string",
      "enum": [
        "remote.layout",
        "aurora.remote.surface",
        "remote.control_set",
        "remote.busking_page",
        "remote.navigation_profile",
        "remote.presentation_profile",
        "remote.permission_profile"
      ]
    },
    "remote_style": {
      "type": "string",
      "enum": ["normal", "primary", "secondary", "warning", "danger", "success", "performance"]
    },
    "qos": {
      "type": "string",
      "enum": ["reliable", "latest", "best_effort"]
    },
    "flag": {
      "type": "string",
      "description": "Unknown optional flags are ignored on typed decode"
    },
    "command_status": {
      "type": "string",
      "minLength": 1,
      "description": "Command disposition. Unknown values are non-success and must not confirm state.",
      "x-known-values": [
        "accepted",
        "rejected",
        "applied",
        "completed",
        "failed",
        "duplicate",
        "in_flight",
        "conflict",
        "expired",
        "precondition_failed",
        "unknown"
      ]
    },
    "source_type": {
      "type": "string",
      "enum": [
        "local_ui",
        "remote",
        "conductor",
        "midi",
        "music_engine",
        "automation",
        "bridge",
        "system"
      ]
    },
    "traffic_class": {
      "type": "string",
      "enum": ["safety", "interactive", "state", "background", "telemetry"]
    },
    "delivery_policy": {
      "type": "string",
      "enum": ["in_order", "latest_value_wins", "never_coalesce"]
    },
    "availability_reason": {
      "type": "string",
      "enum": [
        "no_show_loaded",
        "not_armed",
        "output_offline",
        "permission_denied",
        "wrong_mode",
        "sync_required",
        "interlock_active",
        "resource_unavailable"
      ]
    },
    "precondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "field"],
      "properties": {
        "op": { "type": "string", "enum": ["equals", "at_least"] },
        "field": {
          "type": "string",
          "enum": [
            "authority_epoch",
            "revision",
            "show_id",
            "current_cue_id",
            "resource_field"
          ]
        },
        "value": true,
        "resource": { "type": "string", "minLength": 1 },
        "resource_field": { "type": "string", "minLength": 1 }
      }
    },
    "command_provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["command_id", "source_type"],
      "properties": {
        "node_id": { "$ref": "#/$defs/uuid" },
        "instance_id": { "$ref": "#/$defs/uuid" },
        "session_id": { "$ref": "#/$defs/uuid" },
        "principal_id": { "type": "string", "minLength": 1 },
        "command_id": { "$ref": "#/$defs/uuid" },
        "source_type": { "$ref": "#/$defs/source_type" },
        "display_name": { "type": "string" }
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": true,
      "required": ["action", "available"],
      "properties": {
        "action": { "type": "string", "minLength": 1 },
        "available": { "type": "boolean" },
        "reason": { "$ref": "#/$defs/availability_reason" },
        "detail": { "type": "string" }
      }
    },
    "confidence": {
      "type": "string",
      "enum": ["unverified", "sent_assumed", "pending", "confirmed", "mismatch"]
    },
    "health_status": {
      "type": "string",
      "enum": ["ok", "degraded", "warning", "critical", "offline"]
    },
    "error_category": {
      "type": "string",
      "enum": ["protocol", "validation", "authentication", "authorization", "not_found", "conflict", "unavailable", "timeout", "internal"]
    },
    "error_severity": {
      "type": "string",
      "enum": ["info", "warning", "error", "critical"]
    },
    "requirement": {
      "type": "string",
      "enum": ["required", "recommended", "optional"]
    },
    "conformance_state": {
      "type": "string",
      "enum": ["ready", "syncing", "missing", "stale", "hash_mismatch", "incompatible", "degraded", "failed"]
    },
    "assignment_reason": {
      "type": "string",
      "enum": ["explicit_assignment", "performer_preference", "show_default", "fallback"]
    },
    "chart_type": {
      "type": "string",
      "description": "Extensible. Well-known: nashville_number, chord_lyrics, lyrics_only, lead_sheet, sheet_music, custom"
    },
    "auth_mode": {
      "type": "string",
      "enum": ["trusted_lan", "tls", "aurora_trust", "enrollment_spake2plus"]
    },
    "security_profile": {
      "type": "string",
      "enum": ["full", "lightweight"]
    },
    "security_version": {
      "type": "string",
      "const": "1.0"
    },
    "trust_domain_id": { "$ref": "#/$defs/uuid" },
    "enrollment_id": { "$ref": "#/$defs/uuid" },
    "attempt_id": { "$ref": "#/$defs/uuid" },
    "digest_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "credential_id": { "$ref": "#/$defs/digest_id" },
    "identity_key_id": { "$ref": "#/$defs/digest_id" },
    "security_algorithm": {
      "type": "string",
      "enum": ["ecdsa_p256_sha256", "sha256", "hmac_sha256", "hkdf_sha256", "aes_256_gcm"]
    },
    "security_suite": {
      "type": "string",
      "enum": ["ACP-SPAKE2PLUS-P256-SHA256-HKDFSHA256-RAW128-v1", "ACP-SPAKE2PLUS-P256-SHA256-HKDFSHA256-PBKDF2-100K-v1"]
    },
    "enrollment_state": {
      "type": "string",
      "enum": ["closed", "open", "candidate_selected", "secret_acquired", "negotiating", "key_confirmed", "awaiting_operator_approval", "issuing_credential", "awaiting_install_receipt", "complete", "cancelled", "expired", "locked"]
    },
    "enrollment_method": {
      "type": "string",
      "enum": ["manual_code", "qr", "provisioning_file"]
    },
    "credential_status": {
      "type": "string",
      "enum": ["staged", "active", "expired", "revoked", "superseded", "invalid", "unknown"]
    },
    "credential_format": {
      "type": "string",
      "enum": ["x509_der", "acp-compact-credential-v1"]
    },
    "storage_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "hardware_backed", "private_key_exportable"],
      "properties": {
        "class": { "type": "string", "enum": ["hardware_backed", "os_protected", "encrypted_file", "protected_flash", "plain_file", "ephemeral"] },
        "hardware_backed": { "type": "boolean" },
        "private_key_exportable": { "type": "boolean" }
      }
    },
    "authenticated_principal_state": {
      "type": "string",
      "enum": ["unauthenticated", "authenticated", "revoked", "expired", "identity_conflict", "invalid"]
    },
    "security_error_code": {
      "type": "string",
      "enum": [
        "security.enrollment_closed", "security.enrollment_expired", "security.enrollment_locked",
        "security.enrollment_replayed", "security.no_common_suite", "security.authentication_failed", "security.key_confirmation_failed",
        "security.transcript_mismatch", "security.identity_mismatch", "security.trust_domain_mismatch",
        "security.credential_expired", "security.credential_revoked", "security.credential_invalid",
        "security.permission_denied", "security.downgrade_forbidden", "security.storage_failed",
        "security.resource_limit", "security.clock_untrusted"
      ]
    },
    "crypto_bytes": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "x-acp-cbor-type": "byte-string",
      "x-acp-sensitive": true,
      "x-acp-log-policy": "never"
    },
    "public_crypto_bytes": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "x-acp-cbor-type": "byte-string",
      "x-acp-log-policy": "public"
    },
    "encoding": {
      "type": "string",
      "enum": ["cbor", "json"]
    },
    "apply_mode": {
      "type": "string",
      "enum": ["validate_then_commit"]
    },
    "late_policy": {
      "type": "string",
      "enum": ["reject", "execute_immediately"]
    },
    "transfer_locator_mode": {
      "type": "string",
      "enum": ["chunked", "http"]
    },
    "nonneg_int": {
      "type": "integer",
      "minimum": 0
    },
    "uint64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Duration in integer milliseconds"
    },
    "sha256_hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "description": "RFC 3339 UTC with exactly millisecond precision and Z"
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": true,
      "required": ["node_id"],
      "properties": {
        "node_id": { "$ref": "#/$defs/uuid" },
        "component_id": { "type": "string", "minLength": 1 }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/version" }
      }
    },
    "node_identity": {
      "type": "object",
      "additionalProperties": true,
      "required": ["node_id", "instance_id", "role", "name"],
      "properties": {
        "node_id": { "$ref": "#/$defs/uuid" },
        "instance_id": { "$ref": "#/$defs/uuid" },
        "role": { "$ref": "#/$defs/role" },
        "name": { "type": "string", "minLength": 1 },
        "product_version": { "type": "string" }
      }
    },
    "protocol_range": {
      "type": "object",
      "additionalProperties": true,
      "required": ["min", "max"],
      "properties": {
        "min": { "$ref": "#/$defs/version" },
        "max": { "$ref": "#/$defs/version" }
      }
    },
    "error_details": {
      "type": "object",
      "additionalProperties": true
    },
    "error_body": {
      "type": "object",
      "additionalProperties": true,
      "required": ["code", "category", "severity", "message", "retryable"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "category": { "$ref": "#/$defs/error_category" },
        "severity": { "$ref": "#/$defs/error_severity" },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" },
        "details": { "$ref": "#/$defs/error_details" }
      }
    },
    "asset_ref": {
      "type": "object",
      "additionalProperties": true,
      "required": ["asset_id", "asset_type", "revision", "sha256"],
      "properties": {
        "asset_id": { "$ref": "#/$defs/uuid" },
        "asset_type": { "type": "string", "minLength": 1 },
        "revision": { "$ref": "#/$defs/uint64" },
        "sha256": { "$ref": "#/$defs/sha256_hex" },
        "media_type": { "type": "string" },
        "size_bytes": { "$ref": "#/$defs/uint64" },
        "producer": { "type": "string" }
      }
    },
    "show_identity": {
      "type": "object",
      "additionalProperties": true,
      "required": ["show_id", "revision", "manifest_sha256"],
      "properties": {
        "show_id": { "$ref": "#/$defs/uuid" },
        "show_name": { "type": "string" },
        "revision": { "$ref": "#/$defs/uint64" },
        "manifest_sha256": { "$ref": "#/$defs/sha256_hex" },
        "policy": { "type": "string" }
      }
    },
    "state_resource": {
      "type": "object",
      "additionalProperties": true,
      "required": ["resource", "revision", "owner", "value"],
      "properties": {
        "resource": { "type": "string", "minLength": 1 },
        "revision": { "$ref": "#/$defs/uint64" },
        "owner": { "$ref": "#/$defs/endpoint" },
        "value": { "type": "object", "additionalProperties": true },
        "confidence": { "$ref": "#/$defs/confidence" },
        "authority_node_id": { "$ref": "#/$defs/uuid" },
        "authority_epoch": { "$ref": "#/$defs/uint64" }
      }
    }
  }
}
