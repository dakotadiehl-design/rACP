{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora.invalid/acp/schema/bridge/messages.schema.json",
  "title": "ACP Bridge payloads",
  "$defs": {
    "status": {
      "type": "object",
      "additionalProperties": true,
      "required": ["uptime_ms"],
      "properties": {
        "uptime_ms": { "$ref": "../common/defs.schema.json#/$defs/duration_ms" },
        "output_mode": { "type": "string" },
        "universes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "port": { "type": "string" },
              "universe": { "$ref": "../common/defs.schema.json#/$defs/uint64" },
              "enabled": { "type": "boolean" },
              "last_error": { "type": "string" }
            }
          }
        },
        "last_error": { "type": "string" }
      }
    },
    "blackout": {
      "type": "object",
      "additionalProperties": true,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "scope": { "type": "string" },
        "idempotency_key": { "$ref": "../common/defs.schema.json#/$defs/uuid" }
      }
    }
  }
}
