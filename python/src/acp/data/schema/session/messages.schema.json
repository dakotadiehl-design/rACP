{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora.invalid/acp/schema/session/messages.schema.json",
  "title": "ACP session payloads",
  "$defs": {
    "hello": {
      "type": "object",
      "additionalProperties": true,
      "required": ["node", "protocol", "encodings", "profiles", "capabilities", "auth"],
      "properties": {
        "node": { "$ref": "../common/defs.schema.json#/$defs/node_identity" },
        "protocol": { "$ref": "../common/defs.schema.json#/$defs/protocol_range" },
        "encodings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "../common/defs.schema.json#/$defs/encoding" }
        },
        "profiles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "capabilities": {
          "type": "array",
          "items": { "$ref": "../common/defs.schema.json#/$defs/capability" }
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "$ref": "../common/defs.schema.json#/$defs/auth_mode" },
            "trust_domain_id": { "$ref": "../common/defs.schema.json#/$defs/trust_domain_id" },
            "credential_id": { "$ref": "../common/defs.schema.json#/$defs/credential_id" },
            "identity_key_id": { "$ref": "../common/defs.schema.json#/$defs/identity_key_id" },
            "channel_binding": { "$ref": "../common/defs.schema.json#/$defs/crypto_bytes" },
            "security_capabilities": {
              "type": "array", "maxItems": 16, "uniqueItems": true,
              "items": { "$ref": "../common/defs.schema.json#/$defs/capability" }
            }
          },
          "allOf": [{
            "if": { "properties": { "mode": { "const": "aurora_trust" } }, "required": ["mode"] },
            "then": { "required": ["trust_domain_id", "credential_id", "identity_key_id", "channel_binding", "security_capabilities"] }
          }]
        }
      }
    },
    "hello_ack": {
      "type": "object",
      "additionalProperties": true,
      "required": ["accepted", "protocol", "encoding", "session_id", "heartbeat_interval_ms", "peer_capabilities", "limits", "node"],
      "properties": {
        "accepted": { "type": "boolean" },
        "node": { "$ref": "../common/defs.schema.json#/$defs/node_identity" },
        "protocol": { "$ref": "../common/defs.schema.json#/$defs/version" },
        "encoding": { "$ref": "../common/defs.schema.json#/$defs/encoding" },
        "session_id": { "$ref": "../common/defs.schema.json#/$defs/uuid" },
        "heartbeat_interval_ms": { "$ref": "../common/defs.schema.json#/$defs/duration_ms" },
        "peer_capabilities": {
          "type": "array",
          "items": { "$ref": "../common/defs.schema.json#/$defs/capability" }
        },
        "limits": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "max_message_bytes": { "$ref": "../common/defs.schema.json#/$defs/uint64" }
          }
        },
        "error": { "$ref": "../common/defs.schema.json#/$defs/error_body" },
        "authenticated_session": {
          "type": "object", "additionalProperties": false,
          "required": ["principal_state", "auth_mode", "channel_binding_verified", "downgraded"],
          "properties": {
            "principal_state": { "$ref": "../common/defs.schema.json#/$defs/authenticated_principal_state" },
            "auth_mode": { "$ref": "../common/defs.schema.json#/$defs/auth_mode" },
            "trust_domain_id": { "$ref": "../common/defs.schema.json#/$defs/trust_domain_id" },
            "credential_id": { "$ref": "../common/defs.schema.json#/$defs/credential_id" },
            "identity_key_id": { "$ref": "../common/defs.schema.json#/$defs/identity_key_id" },
            "credential_format": { "$ref": "../common/defs.schema.json#/$defs/credential_format" },
            "channel_binding_verified": { "type": "boolean" },
            "downgraded": { "type": "boolean" }
          }
        }
      }
    },
    "goodbye": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "reason": { "type": "string" }
      }
    }
  }
}
