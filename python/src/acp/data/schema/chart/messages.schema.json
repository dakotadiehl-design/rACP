{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora.invalid/acp/schema/chart/messages.schema.json",
  "title": "ACP chart payloads",
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": ["asset_id", "asset_type", "song_id", "revision", "sha256", "chart_type"],
      "properties": {
        "asset_id": { "$ref": "../common/defs.schema.json#/$defs/uuid" },
        "asset_type": { "const": "lyric.chart" },
        "song_id": { "type": "string" },
        "revision": { "$ref": "../common/defs.schema.json#/$defs/uint64" },
        "sha256": { "$ref": "../common/defs.schema.json#/$defs/sha256_hex" },
        "chart_type": { "$ref": "../common/defs.schema.json#/$defs/chart_type" },
        "instrument": { "type": "string" },
        "variant": { "type": "string" },
        "transposition": { "type": "integer" },
        "display_metadata": { "type": "object", "additionalProperties": true }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": true,
      "required": ["charts"],
      "properties": {
        "charts": {
          "type": "array",
          "items": { "$ref": "#/$defs/metadata" }
        }
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": true,
      "required": ["show_id", "song_id", "participant_id", "chart"],
      "properties": {
        "show_id": { "$ref": "../common/defs.schema.json#/$defs/uuid" },
        "song_id": { "type": "string" },
        "participant_id": { "$ref": "../common/defs.schema.json#/$defs/uuid" },
        "device_id": { "$ref": "../common/defs.schema.json#/$defs/uuid" },
        "chart": {
          "type": "object",
          "additionalProperties": true,
          "required": ["asset_id", "revision", "sha256"],
          "properties": {
            "asset_id": { "$ref": "../common/defs.schema.json#/$defs/uuid" },
            "revision": { "$ref": "../common/defs.schema.json#/$defs/uint64" },
            "sha256": { "$ref": "../common/defs.schema.json#/$defs/sha256_hex" }
          }
        },
        "reason": { "$ref": "../common/defs.schema.json#/$defs/assignment_reason" }
      }
    },
    "assignment_set": {
      "type": "object",
      "additionalProperties": true,
      "required": ["assignments"],
      "properties": {
        "assignments": {
          "type": "array",
          "items": { "$ref": "#/$defs/assignment" }
        }
      }
    }
  }
}
