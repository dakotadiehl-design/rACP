{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora.example/acp/security/conformance/manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixture_set_version", "acp_protocol_version", "acp_security_version", "fixtures"],
  "properties": {
    "fixture_set_version": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$" },
    "acp_protocol_version": { "const": "1.2" },
    "acp_security_version": { "const": "1.0" },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/fixture" }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "digest_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "artifact_type", "path", "producer", "provenance", "canonical_encoding", "sha256", "dependencies", "expectation", "identities", "compatibility_notes"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
        "artifact_type": {
          "enum": ["canonical_spki", "authority_identity", "x509_chain", "issuance_metadata", "revocation_state", "negative_mutation"]
        },
        "path": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[a-z0-9._/-]+$" },
        "producer": {
          "type": "object", "additionalProperties": false,
          "required": ["implementation", "language", "version", "source_commit"],
          "properties": {
            "implementation": { "type": "string", "minLength": 1 },
            "language": { "enum": ["swift", "rust", "python"] },
            "version": { "type": "string", "minLength": 1 },
            "source_commit": { "type": "string", "pattern": "^(working-tree|[0-9a-f]{40})$" }
          }
        },
        "provenance": {
          "type": "object", "additionalProperties": false,
          "required": ["method", "tool", "source", "deterministic_inputs"],
          "properties": {
            "method": { "enum": ["generated", "derived", "hand-authored"] },
            "tool": { "type": "string", "minLength": 1 },
            "source": { "type": "string", "minLength": 1 },
            "deterministic_inputs": { "type": "array", "items": { "type": "string" } }
          }
        },
        "canonical_encoding": { "enum": ["canonical_json", "rfc5480_spki_der_hex", "x509_der_base64", "acp_cbor_hex"] },
        "sha256": { "$ref": "#/$defs/digest" },
        "dependencies": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "expectation": {
          "type": "object", "additionalProperties": false,
          "required": ["result", "error_category"],
          "properties": {
            "result": { "enum": ["accept", "reject"] },
            "error_category": {
              "type": ["string", "null"],
              "enum": [null, "security.authentication_failed", "security.key_confirmation_failed", "security.transcript_mismatch", "security.identity_mismatch", "security.trust_domain_mismatch", "security.credential_expired", "security.credential_revoked", "security.credential_invalid", "security.enrollment_replayed", "security.storage_failed", "security.resource_limit", "security.clock_untrusted"]
            }
          }
        },
        "identities": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "trust_domain_id": { "$ref": "#/$defs/uuid" },
            "authority_key_id": { "$ref": "#/$defs/digest_id" },
            "node_id": { "$ref": "#/$defs/uuid" },
            "identity_key_id": { "$ref": "#/$defs/digest_id" },
            "credential_id": { "$ref": "#/$defs/digest_id" }
          }
        },
        "compatibility_notes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
