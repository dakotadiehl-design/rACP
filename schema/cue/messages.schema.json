{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora.invalid/acp/schema/cue/messages.schema.json",
  "title": "ACP cue payloads",
  "$defs": {
    "go": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "target_context": { "type": "string" },
        "idempotency_key": { "$ref": "../common/defs.schema.json#/$defs/uuid" }
      }
    },
    "fire": {
      "type": "object",
      "additionalProperties": true,
      "required": ["cue_id"],
      "properties": {
        "cue_id": { "type": "string" },
        "idempotency_key": { "$ref": "../common/defs.schema.json#/$defs/uuid" }
      }
    },
    "stop": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "cue_id": { "type": "string" },
        "idempotency_key": { "$ref": "../common/defs.schema.json#/$defs/uuid" }
      }
    }
  }
}
