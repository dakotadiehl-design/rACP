{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora.invalid/acp/schema/transport/messages.schema.json",
  "title": "ACP transport payloads",
  "$defs": {
    "play": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "idempotency_key": { "$ref": "../common/defs.schema.json#/$defs/uuid" }
      }
    },
    "pause": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "idempotency_key": { "$ref": "../common/defs.schema.json#/$defs/uuid" }
      }
    },
    "stop": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "idempotency_key": { "$ref": "../common/defs.schema.json#/$defs/uuid" }
      }
    },
    "seek": {
      "type": "object",
      "additionalProperties": true,
      "required": ["position_ms"],
      "properties": {
        "position_ms": { "$ref": "../common/defs.schema.json#/$defs/duration_ms" },
        "idempotency_key": { "$ref": "../common/defs.schema.json#/$defs/uuid" }
      }
    }
  }
}
