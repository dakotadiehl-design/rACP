{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora.invalid/acp/schema/config/result.schema.json",
  "title": "config.result payload — secrets must not appear",
  "type": "object",
  "additionalProperties": true,
  "required": ["transaction_id", "status"],
  "properties": {
    "transaction_id": { "$ref": "../common/defs.schema.json#/$defs/uuid" },
    "status": { "$ref": "../common/defs.schema.json#/$defs/command_status" },
    "new_revision": { "$ref": "../common/defs.schema.json#/$defs/uint64" },
    "restart_required": { "type": "boolean" },
    "field_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["path", "status"],
        "properties": {
          "path": { "type": "string" },
          "status": { "type": "string" },
          "configured": { "type": "boolean" },
          "error": { "$ref": "../common/defs.schema.json#/$defs/error_body" }
        }
      }
    },
    "error": { "$ref": "../common/defs.schema.json#/$defs/error_body" }
  }
}
