{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora.invalid/acp/schema/state/messages.schema.json",
  "title": "ACP state payloads",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "resources": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": true,
      "required": ["resources"],
      "properties": {
        "authority_epoch": { "$ref": "../common/defs.schema.json#/$defs/uint64" },
        "revision": { "$ref": "../common/defs.schema.json#/$defs/uint64" },
        "resources": {
          "type": "array",
          "items": { "$ref": "../common/defs.schema.json#/$defs/state_resource" }
        }
      }
    },
    "delta": {
      "oneOf": [
        { "$ref": "../common/defs.schema.json#/$defs/state_resource" },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["authority_epoch", "base_revision", "revision", "changes"],
          "properties": {
            "authority_epoch": { "$ref": "../common/defs.schema.json#/$defs/uint64" },
            "base_revision": { "$ref": "../common/defs.schema.json#/$defs/uint64" },
            "revision": { "$ref": "../common/defs.schema.json#/$defs/uint64" },
            "changes": {
              "type": "array",
              "items": { "$ref": "../common/defs.schema.json#/$defs/state_resource" }
            }
          }
        }
      ]
    }
  }
}
