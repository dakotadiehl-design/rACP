{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora.invalid/acp/schema/participant/messages.schema.json",
  "title": "ACP participant payloads",
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": true,
      "required": ["participant_id"],
      "properties": {
        "participant_id": { "$ref": "../common/defs.schema.json#/$defs/uuid" },
        "name": { "type": "string" }
      }
    },
    "preference": {
      "type": "object",
      "additionalProperties": true,
      "required": ["participant_id", "preferred_chart_type"],
      "properties": {
        "participant_id": { "$ref": "../common/defs.schema.json#/$defs/uuid" },
        "preferred_chart_type": { "$ref": "../common/defs.schema.json#/$defs/chart_type" }
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": true,
      "required": ["participant_id", "device_id"],
      "properties": {
        "participant_id": { "$ref": "../common/defs.schema.json#/$defs/uuid" },
        "device_id": { "$ref": "../common/defs.schema.json#/$defs/uuid" },
        "node_id": { "$ref": "../common/defs.schema.json#/$defs/uuid" }
      }
    }
  }
}
