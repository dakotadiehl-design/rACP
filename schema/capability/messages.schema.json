{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora.invalid/acp/schema/capability/messages.schema.json",
  "title": "ACP capability payloads",
  "$defs": {
    "list": {
      "type": "object",
      "additionalProperties": true,
      "required": ["capabilities"],
      "properties": {
        "capabilities": {
          "type": "array",
          "items": { "$ref": "../common/defs.schema.json#/$defs/capability" }
        }
      }
    },
    "changed": {
      "type": "object",
      "additionalProperties": true,
      "required": ["capabilities"],
      "properties": {
        "capabilities": {
          "type": "array",
          "items": { "$ref": "../common/defs.schema.json#/$defs/capability" }
        },
        "added": {
          "type": "array",
          "items": { "$ref": "../common/defs.schema.json#/$defs/capability" }
        },
        "removed": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
