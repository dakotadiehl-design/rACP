{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora.invalid/acp/schema/discovery/messages.schema.json",
  "title": "ACP discovery payloads",
  "$defs": {
    "query": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "requester": { "$ref": "../common/defs.schema.json#/$defs/node_identity" },
        "role_filter": {
          "type": "array",
          "items": { "$ref": "../common/defs.schema.json#/$defs/role" }
        }
      }
    },
    "advertisement": {
      "type": "object",
      "additionalProperties": true,
      "required": ["node", "protocol", "endpoint_url", "capabilities_digest", "security_mode"],
      "properties": {
        "node": { "$ref": "../common/defs.schema.json#/$defs/node_identity" },
        "protocol": { "$ref": "../common/defs.schema.json#/$defs/protocol_range" },
        "endpoint_url": { "type": "string", "minLength": 1 },
        "capabilities_digest": { "type": "string" },
        "security_mode": { "$ref": "../common/defs.schema.json#/$defs/auth_mode" }
      }
    }
  }
}
