{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora.invalid/acp/schema/remote/remote_presentation.schema.json",
  "title": "ACP Remote presentation state",
  "type": "object",
  "additionalProperties": false,
  "required": ["show_id"],
  "properties": {
    "show_id": { "$ref": "../common/defs.schema.json#/$defs/uuid" },
    "show_revision": { "$ref": "../common/defs.schema.json#/$defs/uint64" },
    "song_id": { "type": "string" },
    "next_song_id": { "type": "string" },
    "section_id": { "type": "string" },
    "cue_id": { "type": "string" },
    "next_cue_id": { "type": "string" },
    "transport": { "type": "string" },
    "progress_ms": { "$ref": "../common/defs.schema.json#/$defs/duration_ms" },
    "connection": { "type": "string" },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "extensions": { "type": "object" }
  }
}
