{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora.invalid/acp/schema/remote/remote_control_state.schema.json",
  "title": "ACP Remote control state",
  "type": "object",
  "additionalProperties": false,
  "required": ["control_id", "revision", "enabled", "available"],
  "properties": {
    "control_id": { "type": "string", "minLength": 1 },
    "revision": { "$ref": "../common/defs.schema.json#/$defs/uint64" },
    "enabled": { "type": "boolean" },
    "available": { "type": "boolean" },
    "value": true,
    "confidence": { "$ref": "../common/defs.schema.json#/$defs/confidence" },
    "reason": { "type": "string" },
    "lease_id": { "$ref": "../common/defs.schema.json#/$defs/uuid" },
    "expires_ms": { "$ref": "../common/defs.schema.json#/$defs/duration_ms" },
    "extensions": { "type": "object" }
  }
}
