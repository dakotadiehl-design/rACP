{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora.invalid/acp/schema/remote/remote_control_definition.schema.json",
  "title": "ACP Remote control definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["control_id", "label", "control_type", "binding"],
  "properties": {
    "control_id": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "accessibility_label": { "type": "string" },
    "accessibility_hint": { "type": "string" },
    "control_type": { "$ref": "../common/defs.schema.json#/$defs/remote_control_type" },
    "permission": {
      "anyOf": [
        { "$ref": "../common/defs.schema.json#/$defs/remote_role" },
        { "$ref": "../common/defs.schema.json#/$defs/remote_permission" }
      ]
    },
    "style": { "$ref": "../common/defs.schema.json#/$defs/remote_style" },
    "enabled": { "type": "boolean" },
    "visible": { "type": "boolean" },
    "feedback": { "$ref": "../common/defs.schema.json#/$defs/remote_feedback" },
    "concurrency": { "$ref": "../common/defs.schema.json#/$defs/remote_concurrency" },
    "scope": { "type": "string" },
    "min": { "type": "number" },
    "max": { "type": "number" },
    "step": { "type": "number" },
    "units": { "type": "string" },
    "update_mode": { "type": "string", "enum": ["end", "continuous"] },
    "nominal_rate_hz": { "type": "number" },
    "max_rate_hz": { "type": "number" },
    "qos": { "$ref": "../common/defs.schema.json#/$defs/qos" },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "action"],
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 },
        "parameters": { "type": "object", "additionalProperties": true },
        "extensions": { "type": "object" }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "class": { "$ref": "../common/defs.schema.json#/$defs/remote_safety_class" },
        "failsafe": { "$ref": "../common/defs.schema.json#/$defs/remote_failsafe" },
        "failsafe_required": { "type": "boolean" },
        "max_hold_ms": { "$ref": "../common/defs.schema.json#/$defs/duration_ms" },
        "heartbeat_required": { "type": "boolean" },
        "confirm": { "type": "string" }
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["predicate"],
        "properties": {
          "predicate": { "type": "string", "enum": ["equals", "not_equals", "exists", "capability_present", "permission_present"] },
          "path": { "type": "string" },
          "value": true
        }
      }
    },
    "extensions": { "type": "object" }
  }
}
