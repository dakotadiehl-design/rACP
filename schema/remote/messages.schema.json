{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora.invalid/acp/schema/remote/messages.schema.json",
  "title": "ACP Remote envelope payloads",
  "$defs": {
    "hello": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remote", "roles"],
      "properties": {
        "remote": { "$ref": "remote_identity.schema.json" },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "../common/defs.schema.json#/$defs/remote_role" }
        },
        "capabilities": {
          "type": "array",
          "items": { "$ref": "../common/defs.schema.json#/$defs/capability" }
        },
        "extensions": { "type": "object" }
      }
    },
    "hello_ack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted"],
      "properties": {
        "accepted": { "type": "boolean" },
        "permissions": { "$ref": "remote_permission_set.schema.json" },
        "show_id": { "$ref": "../common/defs.schema.json#/$defs/uuid" },
        "show_revision": { "$ref": "../common/defs.schema.json#/$defs/uint64" },
        "layout_id": { "$ref": "../common/defs.schema.json#/$defs/uuid" },
        "surface_id": { "$ref": "../common/defs.schema.json#/$defs/uuid" },
        "layout_revision": { "$ref": "../common/defs.schema.json#/$defs/uint64" },
        "error": { "$ref": "../common/defs.schema.json#/$defs/error_body" },
        "extensions": { "type": "object" }
      }
    },
    "layout_request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "show_id": { "$ref": "../common/defs.schema.json#/$defs/uuid" },
        "layout_id": { "$ref": "../common/defs.schema.json#/$defs/uuid" },
        "surface_id": { "$ref": "../common/defs.schema.json#/$defs/uuid" },
        "cached_sha256": { "$ref": "../common/defs.schema.json#/$defs/sha256_hex" },
        "sha256": { "$ref": "../common/defs.schema.json#/$defs/sha256_hex" },
        "extensions": { "type": "object" }
      }
    },
    "layout_report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layout": { "$ref": "remote_layout.schema.json" },
        "surface_id": { "$ref": "../common/defs.schema.json#/$defs/uuid" },
        "revision": { "$ref": "../common/defs.schema.json#/$defs/uint64" },
        "sha256": { "$ref": "../common/defs.schema.json#/$defs/sha256_hex" },
        "cached": { "type": "boolean" },
        "asset": { "$ref": "../common/defs.schema.json#/$defs/asset_ref" },
        "extensions": { "type": "object" }
      }
    },
    "control_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controls"],
      "properties": {
        "controls": {
          "type": "array",
          "items": { "$ref": "remote_control_state.schema.json" }
        },
        "snapshot_revision": { "$ref": "../common/defs.schema.json#/$defs/uint64" },
        "extensions": { "type": "object" }
      }
    },
    "navigation_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "enum": ["browse", "select", "load", "next", "previous", "go"] },
        "song_id": { "type": "string" },
        "section_id": { "type": "string" },
        "cue_id": { "type": "string" },
        "show_id": { "$ref": "../common/defs.schema.json#/$defs/uuid" },
        "show_revision": { "$ref": "../common/defs.schema.json#/$defs/uint64" },
        "idempotency_key": { "$ref": "../common/defs.schema.json#/$defs/uuid" },
        "delivery": { "$ref": "../common/defs.schema.json#/$defs/remote_delivery" },
        "issued_at": { "$ref": "../common/defs.schema.json#/$defs/timestamp_utc" },
        "expires_at": { "$ref": "../common/defs.schema.json#/$defs/timestamp_utc" },
        "max_age_ms": { "$ref": "../common/defs.schema.json#/$defs/duration_ms" },
        "extensions": { "type": "object" }
      }
    },
    "navigation_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["show_id"],
      "properties": {
        "show_id": { "$ref": "../common/defs.schema.json#/$defs/uuid" },
        "song_id": { "type": "string" },
        "next_song_id": { "type": "string" },
        "section_id": { "type": "string" },
        "cue_id": { "type": "string" },
        "next_cue_id": { "type": "string" },
        "browsing_song_id": { "type": "string" },
        "selected_song_id": { "type": "string" },
        "mode": { "$ref": "../common/defs.schema.json#/$defs/remote_show_mode" },
        "return_context": { "type": ["object", "null"] },
        "setlist_id": { "type": "string" },
        "setlist_name": { "type": "string" },
        "songs": {
          "type": "array",
          "items": { "type": "object" }
        },
        "extensions": { "type": "object" }
      }
    },
    "momentary_refresh": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control_id", "invocation_id", "lease_id"],
      "properties": {
        "control_id": { "type": "string", "minLength": 1 },
        "invocation_id": { "$ref": "../common/defs.schema.json#/$defs/uuid" },
        "lease_id": { "$ref": "../common/defs.schema.json#/$defs/uuid" },
        "idempotency_key": { "$ref": "../common/defs.schema.json#/$defs/uuid" },
        "extensions": { "type": "object" }
      }
    },
    "error": {
      "allOf": [
        { "$ref": "../common/defs.schema.json#/$defs/error_body" }
      ]
    }
  }
}
