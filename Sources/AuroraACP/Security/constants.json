{
  "$comment": "Provisional ACP v1.2 protocol constants. Collision-check before the first tagged release. After a tagged release these become deployment commitments.",
  "protocol": {
    "name": "Aurora Communications Protocol",
    "family": "aurora",
    "baseline": "1.2",
    "min_supported": "1.0",
    "max_supported": "1.2"
  },
  "discovery": {
    "provisional": true,
    "multicast_group": "239.255.40.1",
    "udp_port": 27420,
    "magic": "ACP0",
    "magic_bytes": [65, 67, 80, 48],
    "datagram_version": 1,
    "encoding_cbor": 0,
    "encoding_json": 1,
    "max_datagram_bytes": 1200,
    "advertisement_interval_ms": 2000,
    "advertisement_jitter_ms": 500,
    "query_response_jitter_ms": 200,
    "send_encoding": "cbor"
  },
  "session": {
    "provisional": true,
    "default_ws_port": 27421,
    "ws_path": "/acp",
    "preferred_encoding": "cbor",
    "fallback_encoding": "json",
    "default_auth_mode": "trusted_lan",
    "reconnect_initial_ms": 100,
    "reconnect_max_ms": 5000
  },
  "heartbeat": {
    "full_profile_interval_ms": 1000,
    "lightweight_interval_ms": 5000,
    "offline_missed_intervals": 3,
    "recover_consecutive_goods": 2
  },
  "limits": {
    "full": {
      "max_message_bytes": 1048576,
      "max_nesting_depth": 16,
      "max_collection_length": 4096,
      "max_decoded_bytes": 4194304,
      "outbound_reliable_queue": 256,
      "outbound_latest_keys": 128,
      "outbound_best_effort_queue": 64,
      "max_correlation_waiters": 128,
      "max_subscriptions": 64,
      "max_idempotency_records": 1024,
      "max_concurrent_transfers": 4,
      "max_chunk_bytes": 16384,
      "max_transfer_bytes": 262144
    },
    "lightweight": {
      "max_message_bytes": 8192,
      "max_nesting_depth": 8,
      "max_collection_length": 256,
      "max_decoded_bytes": 32768,
      "outbound_reliable_queue": 32,
      "outbound_latest_keys": 16,
      "outbound_best_effort_queue": 8,
      "max_correlation_waiters": 16,
      "max_subscriptions": 8,
      "max_idempotency_records": 64,
      "max_concurrent_transfers": 1,
      "max_chunk_bytes": 1024,
      "max_transfer_bytes": 32768
    }
  },
  "idempotency": {
    "retain_after_session_ms": 60000
  },
  "blackout": {
    "clear_on_disconnect_default": false
  },
  "security": {
    "version": "1.0",
    "profiles": ["full", "lightweight"],
    "auth_modes": ["trusted_lan", "tls", "aurora_trust", "enrollment_spake2plus"],
    "suites": ["ACP-SPAKE2PLUS-P256-SHA256-HKDFSHA256-RAW128-v1", "ACP-SPAKE2PLUS-P256-SHA256-HKDFSHA256-PBKDF2-100K-v1"],
    "capabilities": {
      "aurora-trust": "1.0",
      "security.identity": "1.0",
      "security.enrollment": "1.0",
      "security.credential_rotation": "1.0",
      "security.revocation": "1.0",
      "security.authenticated_session": "1.0",
      "security.lightweight": "1.0"
    },
    "errors": {
      "security.enrollment_closed": {"category": "authorization", "retryable": false},
      "security.enrollment_expired": {"category": "timeout", "retryable": true},
      "security.enrollment_locked": {"category": "authorization", "retryable": false},
      "security.enrollment_replayed": {"category": "conflict", "retryable": false},
      "security.no_common_suite": {"category": "protocol", "retryable": false},
      "security.authentication_failed": {"category": "authentication", "retryable": false},
      "security.key_confirmation_failed": {"category": "authentication", "retryable": false, "external_code": "security.credential_invalid"},
      "security.transcript_mismatch": {"category": "authentication", "retryable": false, "external_code": "security.credential_invalid"},
      "security.identity_mismatch": {"category": "authentication", "retryable": false},
      "security.trust_domain_mismatch": {"category": "authentication", "retryable": false},
      "security.credential_expired": {"category": "authentication", "retryable": true},
      "security.credential_revoked": {"category": "authentication", "retryable": false},
      "security.credential_invalid": {"category": "authentication", "retryable": false},
      "security.permission_denied": {"category": "authorization", "retryable": false},
      "security.downgrade_forbidden": {"category": "authentication", "retryable": false},
      "security.storage_failed": {"category": "internal", "retryable": true},
      "security.resource_limit": {"category": "unavailable", "retryable": true},
      "security.clock_untrusted": {"category": "unavailable", "retryable": true}
    },
    "limits": {
      "full": {"concurrent_attempts": 2, "attempts_per_enrollment": 5, "attempt_timeout_ms": 60000, "enrollment_window_ms": 600000, "max_security_message_bytes": 65536, "max_credential_bytes": 8192, "max_nesting_depth": 16, "max_collection_length": 4096, "max_revocation_entries": 4096, "max_trust_domains": null, "active_credentials_per_domain": 2},
      "lightweight": {"concurrent_attempts": 1, "attempts_per_enrollment": 5, "attempt_timeout_ms": 60000, "enrollment_window_ms": 600000, "max_security_message_bytes": 8192, "max_credential_bytes": 2048, "max_nesting_depth": 8, "max_collection_length": 64, "max_revocation_entries": 128, "max_trust_domains": 1, "active_credentials_per_domain": 2}
    },
    "downgrade_policy": {"hardened_allows_trusted_lan_fallback": false},
    "sensitive_annotations": {"value": "x-acp-sensitive", "log_policy": "x-acp-log-policy", "never": "never"},
    "binary_fields": {
      "session.hello": ["auth.channel_binding"],
      "security.enrollment.challenge": ["identity_public_key", "shareP"],
      "security.enrollment.response": ["shareV", "confirmV"],
      "security.enrollment.confirm": ["confirmP"],
      "security.enrollment.approval": ["nonce", "ciphertext"],
      "security.enrollment.install_result": ["proof_of_possession", "confirmation"],
      "security.credential.renew": ["requested_public_key.public_key", "possession_proof"],
      "security.credential.result": ["credential"],
      "security.revocation.update": ["signature"],
      "security.identity.reset": ["confirmation"],
      "security.lightweight.finished": ["binding"]
    },
    "timestamp_fields": ["effective_at", "expires_at", "issued_at", "next_update", "not_before", "revoked_at", "rotation_deadline"]
  },
  "remote": {
    "profile": "remote",
    "profiles": ["aurora.remote.prism.v1"],
    "reserved_profiles": ["aurora.remote.conductor.v1"],
    "surface_schema_version": "1.0",
    "surface_schema_min": "1.0",
    "surface_schema_max": "1.0",
    "feature_capabilities": [
      "show.navigation",
      "song.selection",
      "song.loading",
      "cue.go",
      "cue.selection",
      "look.global",
      "remote.surfaces",
      "busk.controls",
      "control.momentary",
      "output.blackout",
      "output.blackout.engage",
      "output.blackout.clear",
      "output.grand_master",
      "state.live",
      "system.health"
    ],
    "permissions": [
      "observe",
      "song.select",
      "song.load",
      "cue.execute",
      "look.execute",
      "busk.execute",
      "output.grand_master",
      "output.blackout",
      "output.blackout.engage",
      "output.blackout.clear",
      "remote.surface.use"
    ],
    "capabilities": [
      "remote.profile",
      "remote.layout",
      "remote.control.invoke",
      "remote.control.momentary",
      "remote.control.state",
      "remote.navigation.song",
      "remote.navigation.section",
      "remote.navigation.cue",
      "remote.transport",
      "remote.busking",
      "remote.readiness",
      "remote.asset_sync",
      "remote.presentation"
    ],
    "optional_capabilities": [
      "remote.haptics",
      "remote.multitouch",
      "remote.hardware_surface",
      "remote.local_macros",
      "remote.voice_accessibility",
      "remote.offline_cache"
    ],
    "default_failsafe": "release_on_disconnect",
    "default_max_hold_ms": 10000,
    "slider_ui_hz": 25,
    "actions": [
      "cue.go",
      "nav.go",
      "busk.fog.output",
      "busk.work_lights",
      "busk.blinder",
      "bridge.blackout",
      "output.blackout.set",
      "output.grand_master.set",
      "transport.play",
      "transport.stop",
      "nav.song.select",
      "nav.section.enter",
      "show.song.select",
      "show.song.load",
      "show.song.stop",
      "show.song.next",
      "show.song.previous",
      "show.section.next",
      "show.section.previous",
      "show.section.restart",
      "show.progression.hold",
      "show.free_play.enter",
      "show.free_play.exit",
      "look.recall",
      "look.preview",
      "look.take",
      "look.preview.cancel",
      "effects.stop"
    ],
    "state_namespaces": [
      "show.setlist",
      "show.selected_song",
      "show.current_song",
      "show.current_section",
      "show.next_section",
      "show.mode",
      "show.running",
      "show.progression",
      "look.catalog",
      "look.current",
      "look.preview",
      "output.grand_master",
      "output.blackout",
      "system.health"
    ],
    "executable_surface_keys": [
      "script",
      "javascript",
      "js",
      "lua",
      "python",
      "wasm",
      "html",
      "command",
      "shell",
      "bytecode",
      "plugin",
      "url",
      "href",
      "path",
      "file",
      "filename",
      "exec",
      "eval",
      "src",
      "onclick",
      "onpress",
      "code",
      "binary",
      "wasm_b64",
      "executable",
      "source",
      "expression"
    ],
    "never_coalesce_actions": [
      "performance.go",
      "performance.back",
      "cue.fire",
      "cue.go",
      "momentary.begin",
      "momentary.end",
      "blackoutOn",
      "blackoutOff",
      "nav.go",
      "look.take",
      "show.section.next",
      "show.section.previous",
      "show.section.restart",
      "busk.fog.output",
      "busk.blinder"
    ],
    "action_delivery": {
      "cue.go": "live_ephemeral",
      "nav.go": "live_ephemeral",
      "busk.fog.output": "live_ephemeral",
      "busk.work_lights": "stateful",
      "busk.blinder": "live_ephemeral",
      "bridge.blackout": "stateful",
      "output.blackout.set": "stateful",
      "output.grand_master.set": "stateful",
      "transport.play": "impulse",
      "transport.stop": "impulse",
      "nav.song.select": "stateful",
      "nav.section.enter": "impulse",
      "show.song.select": "stateful",
      "show.song.load": "impulse",
      "show.song.stop": "impulse",
      "show.song.next": "impulse",
      "show.song.previous": "impulse",
      "show.section.next": "live_ephemeral",
      "show.section.previous": "live_ephemeral",
      "show.section.restart": "live_ephemeral",
      "show.progression.hold": "stateful",
      "show.free_play.enter": "impulse",
      "show.free_play.exit": "impulse",
      "look.recall": "impulse",
      "look.preview": "impulse",
      "look.take": "live_ephemeral",
      "look.preview.cancel": "impulse",
      "effects.stop": "impulse"
    }
  }
}
