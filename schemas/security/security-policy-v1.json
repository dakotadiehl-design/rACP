{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora.example/schemas/security/security-policy-v1.json",
  "title": "ACP version 1 security policy selection",
  "type": "object",
  "additionalProperties": false,
  "required": ["active_session_revocation"],
  "properties": {
    "active_session_revocation": {
      "type": "string",
      "enum": ["hardened_terminate", "explicit_audited_grace"],
      "default": "hardened_terminate"
    }
  }
}
