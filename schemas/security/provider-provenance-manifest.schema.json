{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora.example/acp/security/provider-provenance-manifest.schema.json",
  "title": "ACP Security Provider Provenance Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "adapter_id", "source_revision", "provider",
    "target_triple", "profiles", "key_storage_classes", "qualification"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "adapter_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "source_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "target_triple": { "type": "string", "minLength": 1 },
    "profiles": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["full", "lightweight"] }
    },
    "key_storage_classes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["secure_enclave", "tpm", "secure_element", "keychain", "encrypted_file"] }
    },
    "qualification": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "artifact_sha256"],
      "properties": {
        "status": { "enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"] },
        "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
